# View1 Studio — Telegram Bot Configuration
# Copy to .env and fill in values

# Telegram (get from @BotFather)
TELEGRAM_BOT_TOKEN=your-bot-token-here
TELEGRAM_CHAT_ID=your-chat-id-here

# Paths (auto-detected by bootstrap script)
PROJECT_DIR=/Users/YOUR_USERNAME/view1-studio
AGENTS_DIR=/Users/YOUR_USERNAME/view1-studio/agents
RESULTS_DIR=/Users/YOUR_USERNAME/view1-studio/agents/results

# Bot API port (for dashboard integration)
API_PORT=3847
